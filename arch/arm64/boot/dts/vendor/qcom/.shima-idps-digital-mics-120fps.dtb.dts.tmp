 clock-names = "ahb_clk";
 qcom,support-hw-trigger;
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&gpu_cx_gdsc {
 clocks = <&gcc 30>;
 clock-names = "ahb_clk";
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&gpu_gx_gdsc {
 clocks = <&gcc 30>;
 clock-names = "ahb_clk";
 parent-supply = <&VDD_GFX_LEVEL>;
 qcom,skip-disable-before-sw-enable;
 status = "ok";
};

&video_cc_mvs0_gdsc {
 clocks = <&gcc 148>;
 clock-names = "ahb_clk";
 qcom,support-hw-trigger;
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&video_cc_mvs0c_gdsc {
 clocks = <&gcc 148>;
 clock-names = "ahb_clk";
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&video_cc_mvs1_gdsc {
 clocks = <&gcc 148>;
 clock-names = "ahb_clk";
 qcom,support-hw-trigger;
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&video_cc_mvs1c_gdsc {
 clocks = <&gcc 148>;
 clock-names = "ahb_clk";
 parent-supply = <&VDD_CX_LEVEL>;
 status = "ok";
};

&qupv3_se5_i2c {
 status = "ok";
 nq@64 {
  compatible = "rtc6226";
  reg = <0x64>;
  fmint-gpio = <&tlmm 50 0>;
  vdd-supply = <&L11C>;
  rtc6226,vdd-supply-voltage = <2800000 2800000>;
  rtc6226,vdd-load = <30000>;
  vio-supply = <&S10B>;
  rtc6226,vio-supply-voltage = <1800000 1800000 >;
 };
};


&qupv3_se15_4uart {
 status = "ok";
};

# 1 "arch/arm64/boot/dts/vendor/qcom/msm-rdbg.dtsi" 1
&soc {

 qcom,smp2p_interrupt_rdbg_2_out {
  compatible = "qcom,smp2p-interrupt-rdbg-2-out";
  qcom,smem-states = <&smp2p_rdbg2_out 0>;
  qcom,smem-state-names = "rdbg-smp2p-out";
 };

 qcom,smp2p_interrupt_rdbg_2_in {
  compatible = "qcom,smp2p-interrupt-rdbg-2-in";
  interrupts-extended = <&smp2p_rdbg2_in 0 0>;
  interrupt-names = "rdbg-smp2p-in";
 };

 qcom,smp2p_interrupt_rdbg_5_out {
  compatible = "qcom,smp2p-interrupt-rdbg-5-out";
  qcom,smem-states = <&smp2p_rdbg5_out 0>;
  qcom,smem-state-names = "rdbg-smp2p-out";
 };

 qcom,smp2p_interrupt_rdbg_5_in {
  compatible = "qcom,smp2p-interrupt-rdbg-5-in";
  interrupts-extended = <&smp2p_rdbg5_in 0 0>;
  interrupt-names = "rdbg-smp2p-in";
 };
};
