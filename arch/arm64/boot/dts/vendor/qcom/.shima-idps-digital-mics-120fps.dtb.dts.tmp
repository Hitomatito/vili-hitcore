  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-governor = "step_wise";
  thermal-sensors = <&tsens1 9>;
  trips {
   mdmss10_config: active-config0 {
    temperature = <95000>;
    hysteresis = <3000>;
    type = "passive";
   };

   mdmss11_config: active-config1 {
    temperature = <98000>;
    hysteresis = <2000>;
    type = "passive";
   };

   mdmss12_config: active-config2 {
    temperature = <105000>;
    hysteresis = <5000>;
    type = "passive";
   };
  };

  cooling-maps {
   mdmss10_cdev {
    trip = <&mdmss10_config>;
    cooling-device = <&modem_tj 1 1>;
   };

   mdmss11_cdev {
    trip = <&mdmss11_config>;
    cooling-device = <&modem_tj 2 2>;
   };

   mdmss12_cdev {
    trip = <&mdmss12_config>;
    cooling-device = <&modem_tj 3 3>;
   };
  };
 };

