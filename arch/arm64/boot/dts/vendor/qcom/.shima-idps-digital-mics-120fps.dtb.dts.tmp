# 2 "arch/arm64/boot/dts/vendor/qcom/shima-thermal-overlay.dtsi" 2

&mdss_mdp {
 #cooling-cells = <2>;
};

&battery_charger {
 #cooling-cells = <2>;
};

&thermal_zones {
 socd {
  disable-thermal-zone;
  cooling-maps {
   socd_cpu4 {
    trip = <&socd_trip>;
    cooling-device = <&cpu4_isolate 1 1>;
   };

   socd_cpu5 {
    trip = <&socd_trip>;
    cooling-device = <&cpu5_isolate 1 1>;
   };

   socd_cpu6 {
    trip = <&socd_trip>;
    cooling-device = <&cpu6_isolate 1 1>;
   };

   socd_cpu7 {
    trip = <&socd_trip>;
    cooling-device = <&cpu7_isolate 1 1>;
   };
  };
 };
