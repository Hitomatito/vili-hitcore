  <127796 0>, <1000 0>,
  <255591 0>, <1000 0>,
  <2097152 0>, <102400 0>,
  <4194304 0>, <204800 0>,
  <255591 0>, <1000 0>,
  <511181 0>, <1000 0>,
  <4194304 0>, <204800 0>,
  <8388608 0>, <409600 0>,
  <149422 0>, <1000 0>,
  <298189 0>, <1000 0>,
