     drive-strength = <2>;
     bias-disable;
    };
   };
  };

  nfc {
   nfc_int_active: nfc_int_active {

    mux {

     pins = "gpio87";
     function = "gpio";
    };

    config {
     pins = "gpio87";
     drive-strength = <2>;
     bias-pull-down;
    };
   };

   nfc_int_suspend: nfc_int_suspend {

    mux {

     pins = "gpio87";
     function = "gpio";
    };

    config {
     pins = "gpio87";
     drive-strength = <2>;
     bias-pull-down;
    };
   };

   nfc_enable_active: nfc_enable_active {
    mux {

     pins = "gpio62", "gpio86", "gpio63";
     function = "gpio";
    };

    config {
     pins = "gpio62", "gpio86", "gpio63";
     drive-strength = <2>;
     bias-disable;
    };
   };

   nfc_enable_suspend: nfc_enable_suspend {
    mux {

     pins = "gpio62", "gpio86", "gpio63";
     function = "gpio";
    };

