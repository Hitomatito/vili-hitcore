  regulator-names = "bps-vdd";
  bps-vdd-supply = <&cam_cc_bps_gdsc>;
  clock-names =
   "bps_ahb_clk",
   "bps_areg_clk",
   "bps_axi_clk",
   "bps_clk_src",
   "bps_clk";
  src-clock-name = "bps_clk_src";
  clock-control-debugfs = "true";
  clocks =
   <&camcc 17>,
   <&camcc 18>,
   <&camcc 19>,
   <&camcc 21>,
   <&camcc 20>;

  clock-rates =
   <0 0 0 200000000 0>,
   <0 0 0 400000000 0>,
   <0 0 0 480000000 0>,
   <0 0 0 600000000 0>,
   <0 0 0 600000000 0>;
  clock-cntl-level = "lowsvs", "svs", "svs_l1", "nominal",
   "turbo";
  status = "ok";
 };

