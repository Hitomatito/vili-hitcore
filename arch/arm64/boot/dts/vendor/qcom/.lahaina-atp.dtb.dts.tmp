   effect_0 {

    qcom,effect-id = <0>;
    qcom,wf-vmax-mv = <3600>;
    qcom,wf-pattern-data = <0x01f 0 0>,
       <0x03f 0 0>,
       <0x05f 0 0>,
       <0x07f 0 0>,
       <0x17f 0 0>,
       <0x15f 0 0>,
       <0x13f 0 0>,
       <0x11f 0 0>;
    qcom,wf-pattern-period-us = <6667>;
    qcom,wf-brake-pattern = /bits/ 8 <0x0 0x0 0x0>;
    qcom,wf-pattern-preload;
    qcom,wf-auto-res-disable;
