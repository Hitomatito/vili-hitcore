   compatible = "qcom,spmi-pmic";
   reg = <2 0>;
   #address-cells = <2>;
   #size-cells = <0>;
   qcom,can-sleep;
  };

  qcom,pm8350b-debug@3 {
   compatible = "qcom,spmi-pmic";
   reg = <3 0>;
   #address-cells = <2>;
   #size-cells = <0>;
   qcom,can-sleep;
  };

  qcom,pmr735a-debug@4 {
   compatible = "qcom,spmi-pmic";
   reg = <4 0>;
   #address-cells = <2>;
   #size-cells = <0>;
   qcom,can-sleep;
  };

  qcom,pmr735b-debug@5 {
   compatible = "qcom,spmi-pmic";
   reg = <5 0>;
   #address-cells = <2>;
   #size-cells = <0>;
   qcom,can-sleep;
  };
 };

