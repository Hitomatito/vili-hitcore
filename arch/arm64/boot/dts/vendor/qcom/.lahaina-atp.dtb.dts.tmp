    qcom,wf-pattern-data = <0x01f 0 0>,
       <0x03f 0 0>,
       <0x05f 0 0>,
       <0x07f 0 0>,
       <0x17f 0 0>,
       <0x15f 0 0>,
       <0x13f 0 0>,
