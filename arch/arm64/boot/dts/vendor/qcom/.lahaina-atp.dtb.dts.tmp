  qcom,sde-vbif-qos-cwb-remap = <3 3 4 4 5 5 6 3>;
  qcom,sde-vbif-qos-lutdma-remap = <3 3 3 3 4 4 4 6>;

  qcom,sde-danger-lut = <0x0000ffff 0x0000ffff 0x00000000
