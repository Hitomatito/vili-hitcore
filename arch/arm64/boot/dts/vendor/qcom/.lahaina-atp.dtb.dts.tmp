  <1844 0>, <1000 0>,
  <3688 0>, <1000 0>,
  <7376 0>, <1000 0>,
  <1844 0>, <1000 0>,
  <3688 0>, <1000 0>,
  <7376 0>, <1000 0>,
  <14752 0>, <1000 0>,
  <127796 0>, <1000 0>,
  <255591 0>, <1000 0>,
  <1492582 0>, <102400 0>,
  <2915200 0>, <204800 0>,
  <255591 0>, <1000 0>,
  <511181 0>, <1000 0>,
  <1492582 0>, <204800 0>,
  <2915200 0>, <409600 0>,
  <149422 0>, <1000 0>,
  <298189 0>, <1000 0>,
  <1492582 0>, <102400 0>,
  <2915200 0>, <204800 0>,
