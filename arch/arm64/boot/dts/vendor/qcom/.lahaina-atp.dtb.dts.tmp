  };

  VDD_MXA_MMCX_SUPPLY_LEVEL: regulator-pm8350-s5-mmcx-sup-level {
   regulator-name = "pm8350_s5_mmcx_sup_level";
   qcom,set = <3>;
   vin-supply = <&VDD_MXC_MMCX_SUPPLY_LEVEL>;
   regulator-min-microvolt =
    <16>;
   regulator-max-microvolt =
    <65535>;
   qcom,init-voltage-level =
    <16>;
   qcom,min-dropout-voltage-level = <(-1)>;
  };
 };

 rpmh-regulator-gfxlvl {
  compatible = "qcom,rpmh-arc-regulator";
  qcom,resource-name = "gfx.lvl";
  VDD_GFX_LEVEL: S6B_LEVEL:
  pm8350_s6_level: regulator-pm8350-s6-level {
   regulator-name = "pm8350_s6_level";
   qcom,set = <3>;
   regulator-min-microvolt =
    <16>;
   regulator-max-microvolt =
    <65535>;
   qcom,init-voltage-level =
