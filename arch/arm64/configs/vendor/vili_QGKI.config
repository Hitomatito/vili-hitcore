# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_INPUT_FINGERPRINT=y

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Power Supply
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_VILI_FOR_BUILD=y
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
CONFIG_LEDS_QTI_FLASH=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_ST=n
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# stmvl53l5
CONFIG_STMVL53L5=m

# WiFi (QCA_CLD_WLAN must be =m — built-in causes symbol conflicts
# with kernel core nl80211 and IPA framework)
CONFIG_CNSS_QCA6490=y
CONFIG_QCA_CLD_WLAN=m
CONFIG_CLD_LL_CORE=y

# HWID
CONFIG_MI_HARDWARE_ID=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=y

# LTO & CFI (required for SM8350 boot)
CONFIG_LTO_CLANG=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y

# CFI permissive: warnings instead of panic on CFI violations
# Required for KernelSU-Next compatibility on kernel 5.4
CONFIG_CFI_PERMISSIVE=y

# KernelSU-Next (manual hook — matches Titanic)
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Timer
CONFIG_HZ=300
CONFIG_HZ_300=y
