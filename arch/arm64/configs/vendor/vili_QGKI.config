# Fingerprint
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y
CONFIG_INPUT_FINGERPRINT=y

# Haptics
CONFIG_INPUT_AW8697_HAPTIC=y

# Power Supply
CONFIG_BQ_FUEL_GAUGE=y
CONFIG_VILI_FOR_BUILD=y
CONFIG_QTI_BATTERY_CHARGER=y
CONFIG_BACKLIGHT_QCOM_SPMI_WLED=y
CONFIG_LEDS_QTI_FLASH=y

# Proximity
CONFIG_MIUS_PROXIMITY=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS=n
CONFIG_TOUCHSCREEN_ST=n
CONFIG_TOUCHSCREEN_ST_FTS_V521_SPI=y
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=y

# stmvl53l5
CONFIG_STMVL53L5=m

# WiFi — cnss2/cld_ll_core =m (module) to match stock GKI behavior.
# Stock vendor_modprobe.sh loads cnss2 → icnss2 → wlan via modules.dep.
# With =y, stock .ko fails with "duplicate symbols" and wlan never loads.
# CNSS_QCA6490 is bool (not tristate) — must be =y, not =m.
CONFIG_CNSS_QCA6490=y
CONFIG_CNSS2=m
CONFIG_QCA_CLD_WLAN=m
CONFIG_CLD_LL_CORE=m

# HWID
CONFIG_MI_HARDWARE_ID=y

# Thermal
CONFIG_MI_THERMAL_INTERFACE=y

# LTO & CFI (required for SM8350 boot — must match Titanic config)
CONFIG_LTO_CLANG=y
CONFIG_CFI_CLANG=y
CONFIG_CFI_CLANG_SHADOW=y

# CFI enforcing (NOT permissive): exports __cfi_slowpath which vendor modules
# expect. CONFIG_CFI_PERMISSIVE=y exports __cfi_slowpath_diag instead, causing
# "Unknown symbol __cfi_slowpath" errors. TitanicExtended works with enforcing.
# CONFIG_CFI_PERMISSIVE is not set

# Module loading: MODVERSIONS=y so vermagic suffix (SMP preempt mod_unload
# modversions aarch64) matches stock GKI vendor modules (5.4.302-qgki).
# MODULE_FORCE_LOAD=y — allow loading stock vendor modules (msm_drm, hwid, etc.)
# that lack __versions section. Without this, same_magic() does full string
# comparison on vermagic and fails with ENOEXEC ("Exec format error").
CONFIG_MODVERSIONS=y
CONFIG_MODULE_FORCE_LOAD=y

# Clean LOCALVERSION: disable AUTO so uname -r shows only "-hitcore-vXX"
# (no git hash / -dirty suffix). ModCRC check makes the name irrelevant
# for module loading, but keeps the release string clean like stock/Titanic.
# CONFIG_LOCALVERSION_AUTO is not set

# KernelSU-Next v3.2.0-legacy — MANUAL HOOK mode (fixed bootloop; kprobes path
# is unreliable on QGKI 5.4, Titanic uses CONFIG_KSU_MANUAL_HOOK=y).
# Manual call-sites: fs/exec.c, fs/read_write.c, fs/stat.c,
# drivers/input/input.c, kernel/reboot.c.
CONFIG_KSU=y
CONFIG_KSU_MANUAL_HOOK=y

# Timer
CONFIG_HZ=300
CONFIG_HZ_300=y
